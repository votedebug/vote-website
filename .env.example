VITE_SANITY_PROJECT_ID=c0h6oqi4
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
# The URL your Sanity Studio is deployed at (or localhost:3333 in dev).
# Used for Visual Editing overlay links back to the Studio.
VITE_SANITY_STUDIO_URL=http://localhost:3333
# Read-only "Viewer" token, only ever sent while in Visual Editing preview
# mode. Required because anonymous requests can't reliably read draft
# content. Generate via `npx sanity tokens create "label" --role=viewer`
# from studio/. This DOES end up in the public JS bundle (Vite inlines
# env vars at build time) — acceptable here since the token is read-only
# and this site has no sensitive data, but worth knowing.
VITE_SANITY_READ_TOKEN=
